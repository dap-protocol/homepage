{
  "author": {
    "name": "netop://ウィビ",
    "url": "https://dap.sh"
  },
  "devDependencies": {
    "@sveltejs/adapter-auto": "^7.0.0",
    "@sveltejs/kit": "^2.49.1",
    "chronver": "^2020.6.18",
    "del-cli": "^7.0.0",
    "husky": "^9.1.7",
    "npm-run-all": "^4.1.5",
    "sass": "^1.94.2",
    "svelte": "^5.45.5",
    "svelte-adapter-bun-next": "^1.0.3",
    "svelte-check": "^4.3.4",
    "svelte-preprocess": "^6.0.3",
    "terser": "^5.44.1",
    "typescript": "^5.9.3",
    "vite": "^7.2.6"
  },
  "name": "homepage",
  "private": true,
  "scripts": {
    "build": "bun run clean && bun --bun run vite build",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "clean": "del './build' '.svelte-kit' 'bun.lock' 'bun.lockb'",
    "increment": "chronver --increment package",
    "dev": "SETTINGS=development bunx vite dev --host --open --port 4242",
    "prepare": "husky",
    "preview": "vite preview",
    "test": "run-s test:*",
    "test:dependencies": "bun update --latest",
    "test:svelte": "svelte-check"
  },
  "type": "module",
  "version": "2026.02.04"
}
